# ---------------------------------------------------------------------------
# Rahasia — JANGAN PERNAH di-commit
#
# .env.local berisi kunci Supabase dan Gemini milik Anda. Kalau ikut terunggah
# ke repositori publik, siapa pun bisa memakai kuota Gemini Anda dan menyentuh
# basis data Asri Catering.
#
# Yang boleh ikut hanya .env.example — isinya nama variabel tanpa nilainya.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Log & berkas sementara
# ---------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------------------------------------------------------------------------
