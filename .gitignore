# ---------------------------------------------------------------------------
.vercel
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
desktop.ini

# Supabase CLI (bila nanti dipakai untuk deploy)
.branches
.temp
supabase/.temp/
