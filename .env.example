# ---------------------------------------------------------------------------
# Salin berkas ini menjadi .env.local lalu isi nilainya.
# .env.local TIDAK boleh ikut di-commit ke Git.
# ---------------------------------------------------------------------------

# Supabase — Dashboard > Project Settings > Data API
# Kedua nilai di bawah memang boleh terbaca dari browser; yang melindungi data
# adalah Row Level Security, bukan kerahasiaan anon key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role — Dashboard > Project Settings > API Keys.
# RAHASIA, server saja. Dipakai route /api/pesanan dan /api/midtrans untuk
# menyimpan pesanan dan menerima notifikasi pembayaran. Jangan beri awalan
# NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Midtrans — Dashboard > Settings > Access Keys. Kunci sandbox diawali "SB-".
# Server key RAHASIA (server saja); client key boleh terbaca peramban.
MIDTRANS_SERVER_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
# Opsional: paksa mode produksi/sandbox bila deteksi dari awalan kunci keliru.
# MIDTRANS_IS_PRODUCTION=false

# Alamat publik website, dipakai sebagai tujuan kembali setelah membayar.
NEXT_PUBLIC_SITE_URL=https://catering-six-psi.vercel.app

# Gemini — https://aistudio.google.com/apikey
# TANPA awalan NEXT_PUBLIC_ supaya hanya terbaca di sisi server.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Kosongkan blok Supabase bila ingin menjalankan aplikasi dalam mode contoh
# (data tersimpan di localStorage, analisis memakai perhitungan lokal). Akun
# pelanggan dan pembayaran online hanya tersedia bila Supabase dan Midtrans
# terisi. Panduan lengkap: docs/SETUP-PEMBAYARAN.md
