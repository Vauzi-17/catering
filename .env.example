# ---------------------------------------------------------------------------
# Salin berkas ini menjadi .env.local lalu isi nilainya.
# .env.local TIDAK boleh ikut di-commit ke Git.
# ---------------------------------------------------------------------------

# Supabase — Dashboard > Project Settings > Data API
# Kedua nilai di bawah memang boleh terbaca dari browser; yang melindungi data
# adalah Row Level Security, bukan kerahasiaan anon key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Gemini — https://aistudio.google.com/apikey
# TANPA awalan NEXT_PUBLIC_ supaya hanya terbaca di sisi server.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Kosongkan kedua blok di atas bila ingin menjalankan aplikasi dalam mode
# contoh (data tersimpan di localStorage, analisis memakai perhitungan lokal).
